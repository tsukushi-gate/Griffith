{
  "name": "docs-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "gen:api": "uv run --no-project --with griffe python ../scripts/gen_api_docs.py",
    "check:api": "uv run --no-project --with griffe python ../scripts/gen_api_docs.py --check",
    "check:i18n": "uv run --no-project python ../scripts/check_i18n.py",
    "check:assets": "uv run --no-project --with pillow python ../scripts/check_docs_assets.py",
    "check:mermaid": "uv run --no-project python ../scripts/check_docs_mermaid.py",
    "predev": "npm run gen:api",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run gen:api",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.7",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "tailwindcss": "^4.3.3"
  }
}
