# ===========================================
# wandb (Weights & Biases) 設定
# ===========================================

# APIキー: https://wandb.ai/authorize で取得
WANDB_API_KEY=your_api_key_here

# プロジェクト名: wandbダッシュボード上のプロジェクト単位
# 同じプロジェクト内で全実験のrun（train, train_cnn, train_rddlgn）が一覧表示される
# 以前の既定は magicdelta-logic だった。既存のrunと同じprojectに続けて記録したい場合は WANDB_PROJECT=magicdelta-logic を設定する
WANDB_PROJECT=griffith-logic

# エンティティ: wandbのチーム名またはユーザー名（省略時は個人アカウント）
# チームで共有する場合に設定する
WANDB_ENTITY=

# 動作モード:
#   online   - リアルタイムでwandbサーバーに送信（デフォルト）
#   offline  - ローカルにのみ保存（後で `wandb sync` でアップロード可能）
#   disabled - wandbを完全に無効化（ログ記録なし）
WANDB_MODE=online

# ===========================================
# RunPod Secure Cloud 設定（griffith launch --backend runpod）
# ===========================================
# Modalの4〜5割安のSecure Cloudで「pod作成→git pull→学習→自己終了」を回す。
# 初回のみ scripts/runpod_bootstrap.py で deploy key 登録+環境ウォームが必要。

# APIキー: https://www.console.runpod.io/user/settings で取得（Write権限が必要）
RUNPOD_API_KEY=your_runpod_api_key_here

# Network Volume ID: /workspace にマウントする永続ストレージ。RunPodコンソール→Storage
# で作成し、そのIDを設定する（.venv・uvキャッシュ・成果物を永続化）
MD_RUNPOD_VOLUME_ID=

# Data Center ID: Network Volumeと同じリージョンのDC ID（例: EU-RO-1, US-CA-1 等）
MD_RUNPOD_DC=

# 既定GPU（MODAL_GPU互換の別名。scripts/runpod_app.py の GPU_TYPE_MAP で解決）
#   T4 / A10G / A100-80GB / H100 / L40S / RTX4090。未知値は gpu_type_id 直指定
# 注意: A10G→RTX A5000 は在庫N/Aのことが多い(過去の観測)。Volume作成後に
# `griffith runpod gpus` で実測IDを確認し直指定を推奨（例: RTX PRO 4500 系がHigh在庫）
MD_RUNPOD_GPU=A10G

# 同時稼働pod数の上限（preflight。コスト暴走防止。既定4）
MD_RUNPOD_MAX_PODS=4

# ベースDockerイメージ（devel系=nvcc入り。CUDAカーネルJITに必要）。
# 既定は runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
MD_RUNPOD_IMAGE=
